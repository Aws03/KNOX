{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "knox-api",
    "Audience": "knox-web",
    "ExpirationMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "BaseUrl": "http://localhost:5001"
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4.1-mini",
    "MaxTokens": 4000,
    "Temperature": 0.7
  },
  "Brevo": {
    "ApiKey": ""
  },
  "AhaSend": {
    "AccountId": "",
    "ApiKey": "",
    "FromEmail": ""
  },
  "AuthSettings": {
    "RequireEmailVerification": false
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ]
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "OpenApi": {
    "Enabled": false
  }
}
