# KNOX production configuration. Copy to .env next to compose.yml, fill in, then: chmod 600 .env
# Generate secrets with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# ---- Release (scripts/deploy.sh updates these) ----
KNOX_API_VERSION=latest
KNOX_WEB_VERSION=latest
# KNOX_API_IMAGE=ghcr.io/aws03/knox-api
# KNOX_WEB_IMAGE=ghcr.io/aws03/knox-web
# Add compose.storage.yml to self-host object storage on this machine:
COMPOSE_FILE=compose.yml

# ---- Site ----
DOMAIN=knox.example.com
ACME_EMAIL=ops@example.com
# CORS origin for cross-origin callers; defaults to https://$DOMAIN (the SPA itself is same-origin).
# PUBLIC_ORIGIN=https://knox.example.com

# ---- Database ----
# sa is used only by the migrate step; the API connects as DB_APP_LOGIN (read/write data only).
# Passwords: 8+ chars with upper, lower, digit and symbol (SQL Server policy).
DB_SA_PASSWORD=
DB_APP_LOGIN=knox_app
DB_APP_PASSWORD=
DB_NAME=KnoxDb
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=2048

# ---- Auth ----
JWT_SECRET=
JWT_ISSUER=knox-api
JWT_AUDIENCE=knox-web
REQUIRE_EMAIL_VERIFICATION=false
# Creates the first SuperAdmin on the first deploy only; remove it afterwards and change the password in the app.
SEED_ADMIN_EMAIL=admin@knox.example.com
SEED_ADMIN_PASSWORD=

# ---- Object storage (S3-compatible) ----
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region "auto".
# AWS S3: https://s3.<region>.amazonaws.com, region "<region>".
STORAGE_SERVICE_URL=
STORAGE_REGION=auto
# Endpoint browsers use for presigned uploads/downloads when it differs from STORAGE_SERVICE_URL.
STORAGE_PUBLIC_SERVICE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BUCKET=knox-public
STORAGE_PRIVATE_BUCKET=knox-private
# How browsers read public images: a CDN pull zone on the public bucket, e.g. https://knox-public.b-cdn.net
STORAGE_PUBLIC_BASE_URL=
# Optional Bunny CDN pull zone on the private bucket with Token Authentication enabled (videos, documents).
# Without it, private files are served with S3 presigned URLs straight from the bucket.
CDN_PRIVATE_BASE_URL=
CDN_TOKEN_KEY=
MAX_MATERIAL_BYTES=2147483648
# Origins the browser may load media from / upload to (Content-Security-Policy), space-separated.
# e.g. "https://knox-public.b-cdn.net https://knox-private.b-cdn.net https://<account-id>.r2.cloudflarestorage.com"
# With compose.storage.yml the buckets share the site's origin: use "'self'" (keep both quote styles).
CSP_MEDIA_SOURCES=https:

# ---- Email (Brevo is used if set, else AhaSend, else emails are only logged) ----
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=KNOX
AHASEND_ACCOUNT_ID=
AHASEND_API_KEY=
AHASEND_FROM_EMAIL=
AHASEND_FROM_NAME=KNOX

# ---- AI quiz generation (optional) ----
OPENAI_API_KEY=

# ---- Backups (scripts/backup.sh) ----
BACKUP_RETENTION_DAYS=14
# Optional off-site copy, e.g. s3://knox-backups/db (credentials below; endpoint for non-AWS providers).
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
