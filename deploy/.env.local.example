# Local development only (docker compose --env-file .env.local ...). These values are NOT secrets:
# every port is bound to 127.0.0.1 or localhost. Never reuse them for a real deployment (.env.example).
COMPOSE_FILE=compose.yml:compose.storage.yml:compose.local.yml
COMPOSE_PROJECT_NAME=knox-local

# Where the frontend repository is checked out, relative to this folder.
FRONTEND_DIR=../../KNOX_Frontend/uni-hub
HTTP_PORT=8080

# Images are built locally (compose.local.yml); these tags only satisfy compose.yml.
KNOX_API_VERSION=local
KNOX_WEB_VERSION=local

DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost:8080
ACME_EMAIL=dev@localhost

# The same values are in JadaraITKnowledgeSystem.API/appsettings.Development.json for `dotnet run`.
DB_SA_PASSWORD=Knox_Local_Sa_1!
DB_APP_LOGIN=knox_app
DB_APP_PASSWORD=Knox_Local_App_1!
DB_NAME=KnoxDb
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=2048

JWT_SECRET=local-development-signing-key-not-for-production-0123456789
REQUIRE_EMAIL_VERIFICATION=false
SEED_ADMIN_EMAIL=admin@knox.com
SEED_ADMIN_PASSWORD=Admin@123456

# SeaweedFS (compose.storage.yml). The API reaches it internally; browsers go through the proxy,
# so presigned URLs are signed for http://localhost:8080 and the CSP only needs 'self'.
STORAGE_SERVICE_URL=http://storage:8333
STORAGE_PUBLIC_SERVICE_URL=http://localhost:8080
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=knox-local
STORAGE_SECRET_KEY=knox-local-secret
STORAGE_PUBLIC_BUCKET=knox-public
STORAGE_PRIVATE_BUCKET=knox-private
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/knox-public
CDN_PRIVATE_BASE_URL=
CDN_TOKEN_KEY=
CSP_MEDIA_SOURCES="'self'"

# Optional: without a key, AI quiz generation jobs fail cleanly with OpenAI.NotConfigured.
OPENAI_API_KEY=
# Without an email provider, emails (verification codes, password resets) are written to the API log.
BREVO_API_KEY=
AHASEND_API_KEY=
