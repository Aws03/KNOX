    {
      "name": "Materials (direct upload, AI generation)",
      "item": [
        {
          "name": "1. Request an upload URL",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/material-uploads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "material-uploads"
              ]
            },
            "description": "Validates type and size (pdf, docx, pptx, png, jpg, mp4, webm; 2 GB by default) and returns a presigned PUT URL. Stores uploadKey, uploadUrl and the Content-Type the upload must use. The body matches sample-lecture.pdf (next to this collection); change fileName/size for your own file.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"lecture.pdf\",\n  \"size\": 734\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"uploadKey\", body.key);",
                  "pm.collectionVariables.set(\"uploadUrl\", body.url);",
                  "pm.collectionVariables.set(\"uploadContentType\", body.headers[\"Content-Type\"]);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Upload the file to storage",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{uploadContentType}}"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": "sample-lecture.pdf"
              }
            },
            "url": {
              "raw": "{{uploadUrl}}",
              "host": [
                "{{uploadUrl}}"
              ]
            },
            "description": "Goes straight to object storage (not the API): pick a small PDF under Body > binary. No bearer token: the signature in the URL is the credential. Expect 200 from storage."
          }
        },
        {
          "name": "3. Create the material",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}/materials",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}",
                "materials"
              ]
            },
            "description": "The API verifies the upload, copies it under materials/{courseId}/ and returns the material with a short-lived signed contentUrl. Stores materialId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lecture 1\",\n  \"uploadKey\": \"{{uploadKey}}\",\n  \"folderId\": null,\n  \"description\": \"Slides\",\n  \"tags\": [\n    \"week1\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"materialId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Course contents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}",
                "contents"
              ]
            },
            "description": "Folders and materials at the course root (add ?folderId= for a folder). Requires sign-in because every material carries a fresh signed contentUrl: open one in a browser to download or stream it."
          }
        },
        {
          "name": "5. Generate quizzes from it (AI)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
